# Copy to `.env` and fill in from your Supabase project
# (Dashboard → Project Settings → API). The anon key is safe to expose in the
# client because row-level security enforces per-user access.
#
# Leave these blank/unset to run the app in local-only mode (IndexedDB).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
